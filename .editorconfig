root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# JSON is deliberately absent: package.json, package-lock.json and tsconfig.json
# are tab-indented, and an editor reformatting them on save would produce
# whole-file diffs — including on the version field the release workflow reads.
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
