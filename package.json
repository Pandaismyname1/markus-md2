{
	"name": "markus-md2",
	"version": "0.1.0",
	"description": "MD2 — a directive layer over Markdown for AI-authored documents. Compiler, stylesheet, and Markdown-to-MD2 auto-upgrade.",
	"keywords": [
		"markdown",
		"md2",
		"remark",
		"remark-directive",
		"unified",
		"documentation",
		"ai"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pandaismyname1/markus-md2.git"
	},
	"homepage": "https://github.com/Pandaismyname1/markus-md2#readme",
	"bugs": {
		"url": "https://github.com/Pandaismyname1/markus-md2/issues"
	},
	"type": "module",
	"sideEffects": [
		"*.css",
		"./dist/prism-langs.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./compile": {
			"types": "./dist/compile.d.ts",
			"default": "./dist/compile.js"
		},
		"./upgrade": {
			"types": "./dist/upgrade/index.d.ts",
			"default": "./dist/upgrade/index.js"
		},
		"./md2.css": "./css/md2.css",
		"./md2-host.css": "./css/md2-host.css",
		"./md2.bundle.css": "./dist/md2.bundle.css",
		"./css/*": "./css/*",
		"./fixtures/*": "./fixtures/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"css",
		"fixtures",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc && node scripts/bundle-css.mjs",
		"dev": "tsc --watch",
		"test": "vitest --run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run test && npm run build"
	},
	"dependencies": {
		"hast-util-to-html": "^9.0.5",
		"mdast-util-to-hast": "^13.2.1",
		"prismjs": "^1.30.0",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"@types/prismjs": "^1.26.6",
		"typescript": "^5.9.0",
		"vitest": "^4.1.3"
	},
	"engines": {
		"node": ">=18"
	}
}
